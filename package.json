{
  "name": "new-giorgiosaud-io",
  "type": "module",
  "version": "2.0.0",
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "predev": "bun scripts/generateSelfHealMap.ts",
    "dev": "astro dev",
    "build": "bun scripts/generateSelfHealMap.ts && astro build && bun scripts/notifyNewPosts.ts",
    "preview": "astro preview",
    "deploy": "bun run build && wrangler deploy",
    "lint": "biome lint --write .",
    "lint:fix": "biome check --write .",
    "astro": "astro",
    "generate:selfheal": "bun scripts/generateSelfHealingCode.ts",
    "generate:cover": "bun scripts/generateCoverImage.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "auth:generate": "yes | bunx @better-auth/cli generate --config auth.config.ts",
    "test": "bunx vitest run",
    "test:watch": "bunx vitest",
    "test:coverage": "bunx vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.7",
    "@astrojs/mdx": "8.1.5",
    "@astrojs/react": "7.1.8",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/svelte": "9.1.5",
    "@astrojs/vue": "7.1.5",
    "@be-partner-labs/ds": "^1.10.1",
    "@better-auth/passkey": "^1.7.23",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@frontmatter/extensibility": "^0.0.18",
    "@lucide/astro": "^1.72.0",
    "@nanostores/react": "^1.1.0",
    "@nanostores/vue": "^1.1.0",
    "@neondatabase/serverless": "^1.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.11",
    "better-auth": "^1.7.23",
    "drizzle-orm": "^0.45.4",
    "fuse.js": "^7.5.0",
    "nanostores": "^1.5.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.38.0",
    "sharp": "^0.35.5",
    "svelte": "^5.57.3",
    "typescript": "^6.0.3",
    "vue": "^3.5.45",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/ts-plugin": "1.10.7",
    "@biomejs/biome": "2.4.14",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@playwright/test": "^1.65.0",
    "@testing-library/dom": "^10.4.2",
    "@vitest/coverage-v8": "^4.1.12",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.11",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lightningcss": "^1.33.0",
    "lint-staged": "^16.4.0",
    "postgres": "^3.4.9",
    "vitest": "^4.1.12",
    "wrangler": "^4.161.0"
  },
  "overrides": {
    "@better-auth/core": "1.7.23",
    "better-call": "1.4.5",
    "@peculiar/asn1-schema": "2.7.0",
    "vite": "^8.3.6"
  },
  "resolutions": {
    "@better-auth/core": "1.7.23",
    "better-call": "1.4.5",
    "@peculiar/asn1-schema": "2.7.0",
    "vite": "^8.3.6"
  }
}
