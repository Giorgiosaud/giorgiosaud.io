---
import '@be-partner-labs/ds/components/input'
import '@be-partner-labs/ds/components/button'
import '@be-partner-labs/ds/components/badge'
import '@be-partner-labs/ds/components/alert'
import '@be-partner-labs/ds/components/modal'
import AdminLayout from '@components/admin/AdminLayout.astro'
import { db } from '@db'
import { pushSubscriptions, users } from '@db/schema'
import { desc, eq } from 'drizzle-orm'

export const prerender = false

const [allUsers, activeSubscriptions] = await Promise.all([
  db.query.users.findMany({
    orderBy: [
      desc(users.createdAt),
    ],
    limit: 100,
  }),
  db.query.pushSubscriptions.findMany({
    where: eq(pushSubscriptions.isActive, true),
  }),
])

const subscribedUserIds = new Set(
  activeSubscriptions.filter(sub => sub.userId).map(sub => sub.userId),
)
---

<AdminLayout title="Users" currentPage="users">
  <section class="users-section">
    <header class="section-header">
      <h2>Users ({allUsers.length})</h2>
    </header>

    <ul class="user-list">
      {allUsers.map(user => (
        <li class="user-item" data-id={user.id}>
          <div class="user-info">
            {user.image && <img src={user.image} alt="" class="user-avatar" />}
            <div class="user-details">
              <strong>{user.name}</strong>
              <span class="user-email">{user.email}</span>
            </div>
          </div>
          <div class="user-badges">
            <span
              class:list={[
                'bp-badge',
                user.banned
                  ? 'bp-badge--error'
                  : user.role === 'admin'
                    ? 'bp-badge--primary'
                    : 'bp-badge--neutral',
              ]}
            >
              {user.banned ? 'Banned' : (user.role || 'user')}
            </span>
            {subscribedUserIds.has(user.id) && (
              <span class="bp-badge bp-badge--success bp-badge--subtle" role="img" aria-label="Push notifications enabled" title="Push notifications enabled">🔔</span>
            )}
            {user.banned && user.banExpires && (
              <span class="ban-expires">Until {new Date(user.banExpires).toLocaleDateString()}</span>
            )}
          </div>
          <div class="user-actions">
            {subscribedUserIds.has(user.id) && (
              <button type="button" class="bp-btn bp-btn--sm bp-btn--secondary" onclick={`notifyUser('${user.id}', '${user.name?.replace(/'/g, "\\'")}')`}>
                Notify
              </button>
            )}
            {!user.banned ? (
              <button type="button" class="bp-btn bp-btn--sm bp-btn--danger" onclick={`banUser('${user.id}')`}>Ban</button>
            ) : (
              <button type="button" class="bp-btn bp-btn--sm" onclick={`unbanUser('${user.id}')`}>Unban</button>
            )}
          </div>
        </li>
      ))}
    </ul>

    <div id="result-success" class="bp-alert bp-alert--success result" role="status" hidden>
      <div class="bp-alert__content">
        <p class="bp-alert__title" data-result-text></p>
      </div>
    </div>
    <div id="result-error" class="bp-alert bp-alert--error result" role="alert" hidden>
      <div class="bp-alert__content">
        <p class="bp-alert__title" data-result-text></p>
      </div>
    </div>
  </section>

  <!-- Notify User Modal -->
  <dialog id="notify-modal" class="bp-modal" aria-labelledby="notify-modal-title">
    <form method="dialog" id="notify-form" class="modal-form">
      <div class="bp-modal__header">
        <h3 class="bp-modal__title" id="notify-modal-title">Notify <span id="notify-user-name"></span></h3>
      </div>
      <input type="hidden" id="notify-user-id" />

      <div class="bp-field">
        <label class="bp-field__label" for="notify-title">Title</label>
        <input class="bp-input" type="text" id="notify-title" required maxlength="50" placeholder="Hey!" />
      </div>

      <div class="bp-field">
        <label class="bp-field__label" for="notify-body">Message</label>
        <textarea class="bp-input" id="notify-body" required maxlength="200" rows="3" placeholder="Check this out..."></textarea>
      </div>

      <div class="bp-field">
        <label class="bp-field__label" for="notify-url">Link URL (optional)</label>
        <input class="bp-input" type="text" id="notify-url" placeholder="/notebook/my-post" />
      </div>

      <div class="bp-modal__footer">
        <button type="button" class="bp-btn bp-btn--secondary" onclick="closeNotifyModal()">Cancel</button>
        <button type="submit" class="bp-btn">Send Notification</button>
      </div>
    </form>
  </dialog>

  <!-- Ban Modal -->
  <dialog id="ban-modal" class="bp-modal" aria-labelledby="ban-modal-title">
    <form method="dialog" id="ban-form" class="modal-form">
      <div class="bp-modal__header">
        <h3 class="bp-modal__title" id="ban-modal-title">Ban User</h3>
      </div>
      <input type="hidden" id="ban-user-id" />

      <div class="bp-field">
        <label class="bp-field__label" for="ban-reason">Reason (optional)</label>
        <input class="bp-input" type="text" id="ban-reason" placeholder="Spam, harassment, etc." />
      </div>

      <div class="bp-field">
        <label class="bp-field__label" for="ban-duration">Duration</label>
        <select class="bp-input" id="ban-duration">
          <option value="">Permanent</option>
          <option value="1">1 day</option>
          <option value="3">3 days</option>
          <option value="7">1 week</option>
          <option value="14">2 weeks</option>
          <option value="30">1 month</option>
          <option value="90">3 months</option>
          <option value="365">1 year</option>
          <option value="custom">Custom days...</option>
        </select>
      </div>

      <div class="bp-field custom-days" id="custom-days-group" hidden>
        <label class="bp-field__label" for="custom-days">Number of days</label>
        <input class="bp-input" type="number" id="custom-days" min="1" max="3650" placeholder="Enter days" />
      </div>

      <div class="bp-modal__footer">
        <button type="button" class="bp-btn bp-btn--secondary" onclick="closeBanModal()">Cancel</button>
        <button type="submit" class="bp-btn bp-btn--danger">Ban User</button>
      </div>
    </form>
  </dialog>
</AdminLayout>

<script>
  const successAlert = document.getElementById('result-success') as HTMLDivElement
  const errorAlert = document.getElementById('result-error') as HTMLDivElement

  function showResult(ok: boolean, message: string) {
    const target = ok ? successAlert : errorAlert
    const other = ok ? errorAlert : successAlert
    other.hidden = true
    const text = target.querySelector('[data-result-text]')
    if (text) text.textContent = message
    target.hidden = false
  }

  // Notify Modal
  const notifyModal = document.getElementById('notify-modal') as HTMLDialogElement
  const notifyForm = document.getElementById('notify-form') as HTMLFormElement
  const notifyUserIdInput = document.getElementById('notify-user-id') as HTMLInputElement
  const notifyUserNameSpan = document.getElementById('notify-user-name') as HTMLSpanElement
  const notifyTitleInput = document.getElementById('notify-title') as HTMLInputElement
  const notifyBodyInput = document.getElementById('notify-body') as HTMLTextAreaElement
  const notifyUrlInput = document.getElementById('notify-url') as HTMLInputElement

  window.notifyUser = (id: string, name: string) => {
    notifyUserIdInput.value = id
    notifyUserNameSpan.textContent = name
    notifyTitleInput.value = ''
    notifyBodyInput.value = ''
    notifyUrlInput.value = ''
    notifyModal.showModal()
  }

  window.closeNotifyModal = () => notifyModal.close()

  notifyForm?.addEventListener('submit', async (e) => {
    e.preventDefault()
    const userId = notifyUserIdInput.value
    const title = notifyTitleInput.value
    const body = notifyBodyInput.value
    const url = notifyUrlInput.value || undefined

    notifyModal.close()

    try {
      const response = await fetch('/api/push/send-to-user.json', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ userId, title, body, url }),
      })
      const data = await response.json()
      showResult(
        response.ok,
        response.ok ? `Notification sent (${data.result.sent} device(s))` : (data.error || 'Failed to send'),
      )
    } catch {
      showResult(false, 'Network error')
    }
  })

  // Ban Modal
  const banModal = document.getElementById('ban-modal') as HTMLDialogElement
  const banForm = document.getElementById('ban-form') as HTMLFormElement
  const banUserIdInput = document.getElementById('ban-user-id') as HTMLInputElement
  const banReasonInput = document.getElementById('ban-reason') as HTMLInputElement
  const banDurationSelect = document.getElementById('ban-duration') as HTMLSelectElement
  const customDaysGroup = document.getElementById('custom-days-group') as HTMLDivElement
  const customDaysInput = document.getElementById('custom-days') as HTMLInputElement

  banDurationSelect?.addEventListener('change', () => {
    customDaysGroup.hidden = banDurationSelect.value !== 'custom'
    if (banDurationSelect.value === 'custom') customDaysInput.focus()
  })

  window.banUser = (id: string) => {
    banUserIdInput.value = id
    banReasonInput.value = ''
    banDurationSelect.value = ''
    customDaysInput.value = ''
    customDaysGroup.hidden = true
    banModal.showModal()
  }

  window.closeBanModal = () => banModal.close()

  banForm?.addEventListener('submit', async (e) => {
    e.preventDefault()
    const id = banUserIdInput.value
    const reason = banReasonInput.value || undefined

    let days: number | undefined
    if (banDurationSelect.value === 'custom') {
      days = Number(customDaysInput.value)
    } else if (banDurationSelect.value) {
      days = Number(banDurationSelect.value)
    }

    let banExpires: string | undefined
    if (days && days > 0) {
      const expiryDate = new Date()
      expiryDate.setDate(expiryDate.getDate() + days)
      banExpires = expiryDate.toISOString()
    }

    banModal.close()
    await updateUserBan(id, true, reason, banExpires)
  })

  window.unbanUser = async (id: string) => {
    if (!confirm('Unban this user?')) return
    await updateUserBan(id, false)
  }

  async function updateUserBan(id: string, ban: boolean, reason?: string, banExpires?: string) {
    try {
      const response = await fetch(`/api/admin/users/${id}/ban.json`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ban, reason, banExpires }),
      })
      const data = await response.json()
      showResult(response.ok, response.ok ? (ban ? 'User banned' : 'User unbanned') : (data.error || 'Failed'))
      if (response.ok) setTimeout(() => location.reload(), 1000)
    } catch {
      showResult(false, 'Network error')
    }
  }

  declare global {
    interface Window {
      notifyUser: (id: string, name: string) => void
      closeNotifyModal: () => void
      banUser: (id: string) => void
      closeBanModal: () => void
      unbanUser: (id: string) => Promise<void>
    }
  }
</script>

<style>
  .section-header {
    margin-bottom: var(--bp-space-4);
  }

  h2 {
    font-size: var(--bp-text-xl);
    margin: 0;
  }

  .user-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .user-item {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: var(--bp-space-4);
    padding: var(--bp-space-4);
    background: var(--bp-color-bg-elevated);
    border: 1px solid var(--bp-color-border);
    border-radius: var(--bp-radius-lg);
    margin-bottom: var(--bp-space-2);
  }

  .user-info {
    display: flex;
    align-items: center;
    gap: var(--bp-space-3);
  }

  .user-avatar {
    width: 40px;
    height: 40px;
    border-radius: var(--bp-radius-full);
    object-fit: cover;
  }

  .user-details {
    display: flex;
    flex-direction: column;
  }

  .user-email {
    font-size: var(--bp-text-xs);
    color: var(--bp-color-text-muted);
  }

  .user-badges {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--bp-space-1);
  }

  .ban-expires {
    font-size: var(--bp-text-xs);
    color: var(--bp-color-text-muted);
  }

  .user-actions {
    display: flex;
    gap: var(--bp-space-2);
  }

  .result {
    margin-top: var(--bp-space-4);
  }

  .modal-form {
    display: flex;
    flex-direction: column;
    gap: var(--bp-space-4);
  }

  .custom-days[hidden] {
    display: none;
  }
</style>
