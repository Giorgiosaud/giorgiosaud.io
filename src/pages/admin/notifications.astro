---
import '@be-partner-labs/ds/components/input'
import '@be-partner-labs/ds/components/button'
import '@be-partner-labs/ds/components/alert'
import AdminLayout from '@components/admin/AdminLayout.astro'
import { db } from '@db'
import { pushSubscriptions } from '@db/schema'
import { eq } from 'drizzle-orm'

export const prerender = false

const activeSubscriptions = await db.query.pushSubscriptions.findMany({
  where: eq(pushSubscriptions.isActive, true),
})

const subscriberCount = activeSubscriptions.length
---

<AdminLayout title="Notifications" currentPage="notifications">
  <section class="broadcast-section">
    <h2>Send Broadcast Notification</h2>
    <p class="subtitle">Send to all {subscriberCount} subscriber{subscriberCount !== 1 ? 's' : ''}</p>

    <form id="broadcast-form">
      <div class="bp-field">
        <label class="bp-field__label" for="title">Title</label>
        <input class="bp-input" type="text" id="title" name="title" required maxlength="50" placeholder="New blog post!" />
      </div>

      <div class="bp-field">
        <label class="bp-field__label" for="body">Message</label>
        <textarea class="bp-input" id="body" name="body" required maxlength="200" rows="3" placeholder="Check out my latest article..."></textarea>
      </div>

      <div class="bp-field">
        <label class="bp-field__label" for="url">Link URL (optional)</label>
        <input class="bp-input" type="text" id="url" name="url" placeholder="/notebook/my-new-post" />
      </div>

      <button type="submit" class="bp-btn submit">
        Send Broadcast
      </button>
    </form>

    <div id="result-success" class="bp-alert bp-alert--success result" role="status" hidden>
      <div class="bp-alert__content">
        <p class="bp-alert__title" data-result-text></p>
      </div>
    </div>
    <div id="result-error" class="bp-alert bp-alert--error result" role="alert" hidden>
      <div class="bp-alert__content">
        <p class="bp-alert__title" data-result-text></p>
      </div>
    </div>
  </section>
</AdminLayout>

<script>
  const form = document.getElementById('broadcast-form') as HTMLFormElement
  const successAlert = document.getElementById('result-success') as HTMLDivElement
  const errorAlert = document.getElementById('result-error') as HTMLDivElement

  function showResult(ok: boolean, message: string) {
    const target = ok ? successAlert : errorAlert
    const other = ok ? errorAlert : successAlert
    other.hidden = true
    const text = target.querySelector('[data-result-text]')
    if (text) text.textContent = message
    target.hidden = false
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault()

    const formData = new FormData(form)
    const title = formData.get('title') as string
    const body = formData.get('body') as string
    const url = formData.get('url') as string

    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement
    submitBtn.disabled = true
    submitBtn.textContent = 'Sending...'

    try {
      const payload: { type: string; title: string; body: string; url?: string } = { type: 'custom', title, body }
      if (url) payload.url = url

      const response = await fetch('/api/push/broadcast.json', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      })

      const data = await response.json()

      if (response.ok) {
        showResult(true, `Sent to ${data.result.sent} subscriber(s). ${data.result.failed} failed.`)
        form.reset()
      } else {
        showResult(false, data.error || 'Failed to send broadcast')
      }
    } catch {
      showResult(false, 'Network error. Please try again.')
    } finally {
      submitBtn.disabled = false
      submitBtn.textContent = 'Send Broadcast'
    }
  })
</script>

<style>
  .broadcast-section {
    max-width: 500px;
  }

  h2 {
    font-size: var(--bp-text-xl);
    margin-bottom: var(--bp-space-1);
  }

  .subtitle {
    color: var(--bp-color-text-muted);
    margin-bottom: var(--bp-space-6);
  }

  #broadcast-form {
    display: flex;
    flex-direction: column;
    gap: var(--bp-space-4);
  }

  .submit {
    width: 100%;
  }

  .result {
    margin-top: var(--bp-space-4);
  }
</style>
