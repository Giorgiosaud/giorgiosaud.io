---
import AdminLayout from '@components/admin/AdminLayout.astro'
import { db } from '@db'
import { comments, pushSubscriptions, users } from '@db/schema'
import { desc, eq, isNull } from 'drizzle-orm'

export const prerender = false

// Get stats
const [activeSubscriptions, totalComments, totalUsers, recentActivity] =
  await Promise.all([
    db.query.pushSubscriptions.findMany({
      where: eq(pushSubscriptions.isActive, true),
    }),
    db.query.comments.findMany({
      where: isNull(comments.deletedAt),
    }),
    db.query.users.findMany(),
    db.query.comments.findMany({
      where: isNull(comments.deletedAt),
      orderBy: [
        desc(comments.createdAt),
      ],
      limit: 5,
      with: {
        author: true,
      },
    }),
  ])

const stats = {
  subscribers: activeSubscriptions.length,
  comments: totalComments.length,
  users: totalUsers.length,
}
---

<AdminLayout title="Overview" currentPage="dashboard">
  <section class="stats-grid">
    <a href="/admin/notifications" class="stat-card">
      <span class="stat-value">{stats.subscribers}</span>
      <span class="stat-label">Push Subscribers</span>
    </a>
    <a href="/admin/comments" class="stat-card">
      <span class="stat-value">{stats.comments}</span>
      <span class="stat-label">Comments</span>
    </a>
    <a href="/admin/users" class="stat-card">
      <span class="stat-value">{stats.users}</span>
      <span class="stat-label">Users</span>
    </a>
  </section>

  <section class="recent-activity">
    <h2>Recent Comments</h2>
    {recentActivity.length === 0 ? (
      <p class="empty">No comments yet.</p>
    ) : (
      <ul class="activity-list">
        {recentActivity.map(comment => (
          <li class="activity-item">
            <div class="activity-header">
              <strong>{comment.author?.name || 'Unknown'}</strong>
              <span class="activity-date">{new Date(comment.createdAt).toLocaleDateString()}</span>
            </div>
            <p class="activity-content">{comment.content.slice(0, 100)}{comment.content.length > 100 ? '...' : ''}</p>
            <span class="activity-meta">on {comment.noteSelfHealing}</span>
          </li>
        ))}
      </ul>
    )}
    <a href="/admin/comments" class="view-all">View all comments →</a>
  </section>
</AdminLayout>

<style>
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: var(--bp-space-4);
    margin-bottom: var(--bp-space-8);
  }

  .stat-card {
    background: var(--bp-color-bg-elevated);
    border: 1px solid var(--bp-color-border);
    padding: var(--bp-space-6);
    border-radius: var(--bp-radius-lg);
    text-align: center;
    text-decoration: none;
    color: inherit;
    transition:
      transform var(--bp-duration-fast) var(--bp-ease),
      box-shadow var(--bp-duration-fast) var(--bp-ease);
  }

  .stat-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--bp-shadow-md);
  }

  .stat-card:focus-visible {
    outline: none;
    box-shadow: var(--bp-focus-ring);
  }

  .stat-value {
    display: block;
    font-size: var(--bp-text-4xl);
    font-weight: var(--bp-font-weight-bold);
    color: var(--site-color-accent);
  }

  .stat-label {
    color: var(--bp-color-text-muted);
    font-size: var(--bp-text-sm);
  }

  .recent-activity h2 {
    font-size: var(--bp-text-xl);
    margin-bottom: var(--bp-space-4);
  }

  .activity-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .activity-item {
    padding: var(--bp-space-4);
    background: var(--bp-color-bg-elevated);
    border: 1px solid var(--bp-color-border);
    border-radius: var(--bp-radius-lg);
    margin-bottom: var(--bp-space-2);
  }

  .activity-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: var(--bp-space-1);
  }

  .activity-date {
    color: var(--bp-color-text-muted);
    font-size: var(--bp-text-sm);
  }

  .activity-content {
    margin: var(--bp-space-2) 0;
    color: var(--bp-color-text);
  }

  .activity-meta {
    font-size: var(--bp-text-xs);
    color: var(--bp-color-text-muted);
  }

  .empty {
    color: var(--bp-color-text-muted);
    font-style: italic;
  }

  .view-all {
    display: inline-block;
    margin-top: var(--bp-space-4);
    color: var(--site-color-accent);
    text-decoration: none;
  }

  .view-all:hover {
    text-decoration: underline;
  }
</style>
