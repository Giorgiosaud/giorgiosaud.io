---
import { getCollection } from 'astro:content'
import '@be-partner-labs/ds/components/input'
import '@be-partner-labs/ds/components/button'
import '@be-partner-labs/ds/components/badge'
import '@be-partner-labs/ds/components/alert'
import '@be-partner-labs/ds/components/modal'
import AdminLayout from '@components/admin/AdminLayout.astro'
import { db } from '@db'
import { comments } from '@db/schema'
import { and, desc, eq, isNull, like, or, sql } from 'drizzle-orm'

export const prerender = false

// Get notes to map selfHealing codes to titles
const notesEn = await getCollection('notes')
const notesEs = await getCollection('notas')
const notesMap = new Map<
  string,
  {
    title: string
    slug: string
    lang: string
  }
>()

for (const note of notesEn) {
  if (note.data.selfHealing) {
    notesMap.set(note.data.selfHealing, {
      title: note.data.title,
      slug: note.id,
      lang: 'en',
    })
  }
}
for (const note of notesEs) {
  if (note.data.selfHealing && !notesMap.has(note.data.selfHealing)) {
    notesMap.set(note.data.selfHealing, {
      title: note.data.title,
      slug: note.id,
      lang: 'es',
    })
  }
}

// Get filter params
const url = new URL(Astro.request.url)
const filterPost = url.searchParams.get('post') || ''
const filterStatus = url.searchParams.get('status') || 'all'
const searchQuery = url.searchParams.get('q') || ''
const page = parseInt(url.searchParams.get('page') || '1', 10)
const limit = 20

// Build where conditions
const conditions = [
  isNull(comments.deletedAt),
]

if (filterPost) {
  conditions.push(eq(comments.noteSelfHealing, filterPost))
}

if (filterStatus === 'approved') {
  conditions.push(eq(comments.isApproved, true))
} else if (filterStatus === 'pending') {
  conditions.push(eq(comments.isApproved, false))
}

if (searchQuery) {
  conditions.push(like(comments.content, `%${searchQuery}%`))
}

// Get total count for pagination
const [{ count: totalCount }] = await db
  .select({
    count: sql<number>`count(*)::int`,
  })
  .from(comments)
  .where(and(...conditions))

const totalPages = Math.ceil(totalCount / limit)
const offset = (page - 1) * limit
const pageHref = (target: number) =>
  `?${new URLSearchParams({
    page: String(target),
    post: filterPost,
    status: filterStatus,
    q: searchQuery,
  })}`

// Get comments with pagination
const allComments = await db.query.comments.findMany({
  where: and(...conditions),
  orderBy: [
    desc(comments.createdAt),
  ],
  limit,
  offset,
  with: {
    author: true,
  },
})

// Get unique posts for filter dropdown
const uniquePosts = await db
  .selectDistinct({
    noteSelfHealing: comments.noteSelfHealing,
  })
  .from(comments)
  .where(isNull(comments.deletedAt))
  .orderBy(comments.noteSelfHealing)

// Stats
const [stats] = await db
  .select({
    total: sql<number>`count(*)::int`,
    approved: sql<number>`count(*) filter (where is_approved = true)::int`,
    pending: sql<number>`count(*) filter (where is_approved = false)::int`,
  })
  .from(comments)
  .where(isNull(comments.deletedAt))
---

<AdminLayout title="Comments" currentPage="comments">
  <section class="comments-section">
    <header class="section-header">
      <h2>Comments Management</h2>
      <div class="stats">
        <span class="stat">Total: <strong>{stats.total}</strong></span>
        <span class="stat">Approved: <span class="bp-badge bp-badge--success">{stats.approved}</span></span>
        <span class="stat">Pending: <span class="bp-badge bp-badge--warning">{stats.pending}</span></span>
      </div>
    </header>

    <!-- Filters -->
    <form class="filters" method="GET">
      <div class="filter-row">
        <div class="bp-field filter-group">
          <label class="bp-field__label" for="search">Search</label>
          <input
            class="bp-input"
            type="search"
            id="search"
            name="q"
            placeholder="Search comments..."
            value={searchQuery}
          />
        </div>

        <div class="bp-field filter-group">
          <label class="bp-field__label" for="post">Post</label>
          <select class="bp-input" id="post" name="post">
            <option value="">All posts</option>
            {uniquePosts.map(p => {
              const noteInfo = notesMap.get(p.noteSelfHealing)
              return (
                <option value={p.noteSelfHealing} selected={filterPost === p.noteSelfHealing}>
                  {noteInfo?.title || p.noteSelfHealing}
                </option>
              )
            })}
          </select>
        </div>

        <div class="bp-field filter-group">
          <label class="bp-field__label" for="status">Status</label>
          <select class="bp-input" id="status" name="status">
            <option value="all" selected={filterStatus === 'all'}>All</option>
            <option value="approved" selected={filterStatus === 'approved'}>Approved</option>
            <option value="pending" selected={filterStatus === 'pending'}>Pending</option>
          </select>
        </div>

        <button type="submit" class="bp-btn">Filter</button>
        {(filterPost || filterStatus !== 'all' || searchQuery) && (
          <a href="/admin/comments" class="bp-btn bp-btn--secondary">Clear</a>
        )}
      </div>
    </form>

    <!-- Results info -->
    <p class="results-info">
      Showing {allComments.length} of {totalCount} comments
      {searchQuery && <span> matching "{searchQuery}"</span>}
    </p>

    {allComments.length === 0 ? (
      <p class="empty">No comments found.</p>
    ) : (
      <ul class="comment-list">
        {allComments.map(comment => (
          <li class="comment-item" data-id={comment.id} data-approved={comment.isApproved}>
            <div class="comment-header">
              <div class="comment-author">
                <div class="author-row">
                  {comment.author?.image && (
                    <img src={comment.author.image} alt="" class="author-avatar" />
                  )}
                  <strong>{comment.author?.name || 'Unknown'}</strong>
                  <span class="bp-badge status-badge">
                    {comment.isApproved ? 'Approved' : 'Pending'}
                  </span>
                </div>
                <span class="comment-email">{comment.author?.email}</span>
              </div>
              <div class="comment-meta-right">
                <span class="comment-date">{new Date(comment.createdAt).toLocaleString()}</span>
                {comment.depth > 0 && <span class="bp-badge bp-badge--neutral">Reply (depth: {comment.depth})</span>}
              </div>
            </div>

            <p class="comment-content">{comment.content}</p>

            <div class="comment-footer">
              {(() => {
                const noteInfo = notesMap.get(comment.noteSelfHealing)
                const href = noteInfo
                  ? (noteInfo.lang === 'en' ? `/notebook/${noteInfo.slug}` : `/es/cuaderno/${noteInfo.slug}`)
                  : `/notebook/${comment.noteSelfHealing}`
                return (
                  <a
                    href={href}
                    target="_blank"
                    class="post-link"
                    title={noteInfo?.title || comment.noteSelfHealing}
                  >
                    📝 {noteInfo?.title || comment.noteSelfHealing}
                  </a>
                )
              })()}
              <div class="comment-actions">
                {comment.isApproved ? (
                  <button
                    type="button"
                    class="bp-btn bp-btn--sm bp-btn--secondary"
                    onclick={`toggleApproval('${comment.id}', false)`}
                  >
                    Unapprove
                  </button>
                ) : (
                  <button
                    type="button"
                    class="bp-btn bp-btn--sm"
                    onclick={`toggleApproval('${comment.id}', true)`}
                  >
                    Approve
                  </button>
                )}
                <button
                  type="button"
                  class="bp-btn bp-btn--sm bp-btn--danger"
                  onclick={`deleteComment('${comment.id}')`}
                >
                  Delete
                </button>
              </div>
            </div>
          </li>
        ))}
      </ul>
    )}

    <!-- Pagination -->
    {totalPages > 1 && (
      <nav class="pagination" aria-label="Pagination">
        {page > 1 && (
          <a href={pageHref(page - 1)} class="bp-btn bp-btn--secondary bp-btn--sm">
            ← Previous
          </a>
        )}
        <span class="page-info">Page {page} of {totalPages}</span>
        {page < totalPages && (
          <a href={pageHref(page + 1)} class="bp-btn bp-btn--secondary bp-btn--sm">
            Next →
          </a>
        )}
      </nav>
    )}

    <div id="result-success" class="bp-alert bp-alert--success result" role="status" hidden>
      <div class="bp-alert__content">
        <p class="bp-alert__title" data-result-text></p>
      </div>
    </div>
    <div id="result-error" class="bp-alert bp-alert--error result" role="alert" hidden>
      <div class="bp-alert__content">
        <p class="bp-alert__title" data-result-text></p>
      </div>
    </div>
  </section>

  <!-- Delete confirmation dialog -->
  <dialog id="delete-dialog" class="bp-modal" aria-labelledby="delete-dialog-title">
    <form method="dialog">
      <div class="bp-modal__header">
        <h3 class="bp-modal__title" id="delete-dialog-title">Delete Comment</h3>
      </div>
      <div class="bp-modal__body">
        <p>Are you sure you want to delete this comment? This action cannot be undone.</p>
      </div>
      <div class="bp-modal__footer">
        <button type="button" class="bp-btn bp-btn--secondary" onclick="document.getElementById('delete-dialog').close()">
          Cancel
        </button>
        <button type="submit" class="bp-btn bp-btn--danger" id="confirm-delete">
          Delete
        </button>
      </div>
    </form>
  </dialog>
</AdminLayout>

<script>
  let pendingDeleteId: string | null = null
  const deleteDialog = document.getElementById('delete-dialog') as HTMLDialogElement
  const confirmDeleteBtn = document.getElementById('confirm-delete') as HTMLButtonElement
  const successAlert = document.getElementById('result-success') as HTMLDivElement
  const errorAlert = document.getElementById('result-error') as HTMLDivElement

  function showResult(ok: boolean, message: string) {
    const target = ok ? successAlert : errorAlert
    const other = ok ? errorAlert : successAlert
    other.hidden = true
    const text = target.querySelector('[data-result-text]')
    if (text) text.textContent = message
    target.hidden = false
  }

  window.deleteComment = (id: string) => {
    pendingDeleteId = id
    deleteDialog.showModal()
  }

  confirmDeleteBtn.addEventListener('click', async (e) => {
    e.preventDefault()
    if (!pendingDeleteId) return

    const id = pendingDeleteId

    try {
      const response = await fetch(`/api/admin/comments/${id}.json`, { method: 'DELETE' })
      const data = await response.json()

      deleteDialog.close()
      showResult(response.ok, response.ok ? 'Comment deleted' : (data.error || 'Failed to delete'))

      if (response.ok) {
        document.querySelector(`.comment-item[data-id="${id}"]`)?.remove()
      }
    } catch {
      deleteDialog.close()
      showResult(false, 'Network error')
    }

    pendingDeleteId = null
  })

  window.toggleApproval = async (id: string, approve: boolean) => {
    try {
      const response = await fetch(`/api/admin/comments/${id}.json`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ isApproved: approve }),
      })
      const data = await response.json()

      showResult(
        response.ok,
        response.ok ? `Comment ${approve ? 'approved' : 'unapproved'}` : (data.error || 'Failed to update'),
      )

      if (response.ok) {
        // Update UI
        const item = document.querySelector(`.comment-item[data-id="${id}"]`) as HTMLElement
        if (item) {
          item.dataset.approved = String(approve)
          const badge = item.querySelector('.status-badge') as HTMLElement
          // Badge color follows data-approved on the item (CSS)
          badge.textContent = approve ? 'Approved' : 'Pending'

          // Swap buttons
          const actions = item.querySelector('.comment-actions') as HTMLElement
          const approveBtn = approve
            ? `<button type="button" class="bp-btn bp-btn--sm bp-btn--secondary" onclick="toggleApproval('${id}', false)">Unapprove</button>`
            : `<button type="button" class="bp-btn bp-btn--sm" onclick="toggleApproval('${id}', true)">Approve</button>`
          const deleteBtn = `<button type="button" class="bp-btn bp-btn--sm bp-btn--danger" onclick="deleteComment('${id}')">Delete</button>`
          actions.innerHTML = approveBtn + deleteBtn
        }
      }
    } catch {
      showResult(false, 'Network error')
    }
  }

  declare global {
    interface Window {
      deleteComment: (id: string) => void
      toggleApproval: (id: string, approve: boolean) => Promise<void>
    }
  }
</script>

<style>
  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--bp-space-6);
    flex-wrap: wrap;
    gap: var(--bp-space-4);
  }

  h2 {
    font-size: var(--bp-text-2xl);
    margin: 0;
  }

  .stats {
    display: flex;
    gap: var(--bp-space-4);
  }

  .stat {
    font-size: var(--bp-text-sm);
    color: var(--bp-color-text-muted);
  }

  /* Filters */
  .filters {
    background: var(--bp-color-bg-subtle);
    border: 1px solid var(--bp-color-border);
    padding: var(--bp-space-4);
    border-radius: var(--bp-radius-lg);
    margin-bottom: var(--bp-space-4);
  }

  .filter-row {
    display: flex;
    gap: var(--bp-space-4);
    align-items: flex-end;
    flex-wrap: wrap;
  }

  .filter-group {
    min-width: 150px;
  }

  .results-info {
    font-size: var(--bp-text-sm);
    color: var(--bp-color-text-muted);
    margin-bottom: var(--bp-space-4);
  }

  .empty {
    color: var(--bp-color-text-muted);
    font-style: italic;
    text-align: center;
    padding: var(--bp-space-8);
  }

  /* Comment list */
  .comment-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .comment-item {
    padding: var(--bp-space-4);
    background: var(--bp-color-bg-elevated);
    border: 1px solid var(--bp-color-border);
    border-radius: var(--bp-radius-lg);
    margin-bottom: var(--bp-space-3);
    transition: border-color var(--bp-duration-fast) var(--bp-ease);
  }

  /* Approval state comes from data-approved (updated by the script) */
  .comment-item[data-approved='false'] {
    border-left: 3px solid var(--bp-color-warning);
    --badge-background: color-mix(in srgb, var(--bp-color-warning) 15%, transparent);
    --badge-color: var(--bp-color-text);
  }

  .comment-item[data-approved='true'] {
    border-left: 3px solid var(--bp-color-success);
    --badge-background: color-mix(in srgb, var(--bp-color-success) 15%, transparent);
    --badge-color: var(--bp-color-text);
  }

  .status-badge {
    text-transform: uppercase;
  }

  .comment-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: var(--bp-space-2);
    gap: var(--bp-space-4);
  }

  .comment-author {
    display: flex;
    flex-direction: column;
  }

  .author-row {
    display: flex;
    align-items: center;
    gap: var(--bp-space-2);
  }

  .author-avatar {
    width: 24px;
    height: 24px;
    border-radius: var(--bp-radius-full);
  }

  .comment-email {
    font-size: var(--bp-text-xs);
    color: var(--bp-color-text-muted);
  }

  .comment-meta-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--bp-space-1);
  }

  .comment-date {
    font-size: var(--bp-text-xs);
    color: var(--bp-color-text-muted);
  }

  .comment-content {
    margin: var(--bp-space-3) 0;
    line-height: var(--bp-leading-normal);
    padding: var(--bp-space-3);
    background: var(--bp-color-bg-subtle);
    border-radius: var(--bp-radius-sm);
  }

  .comment-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--bp-space-2);
  }

  .post-link {
    font-size: var(--bp-text-xs);
    color: var(--site-color-accent);
    text-decoration: none;
  }

  .post-link:hover {
    text-decoration: underline;
  }

  .comment-actions {
    display: flex;
    gap: var(--bp-space-2);
  }

  /* Pagination */
  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--bp-space-4);
    margin-top: var(--bp-space-6);
    padding-top: var(--bp-space-4);
    border-top: 1px solid var(--bp-color-border);
  }

  .page-info {
    font-size: var(--bp-text-sm);
    color: var(--bp-color-text-muted);
  }

  .result {
    margin-top: var(--bp-space-4);
  }

  @media (max-width: 768px) {
    .section-header {
      flex-direction: column;
      align-items: flex-start;
    }

    .filter-row {
      flex-direction: column;
      align-items: stretch;
    }

    .comment-header {
      flex-direction: column;
    }

    .comment-meta-right {
      align-items: flex-start;
    }

    .comment-footer {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
