---
import { actions } from 'astro:actions'
import ContactPage from '@components/ContactPage.astro'
import { getLangFromUrl, useTranslations } from '@i18n/utils'
import Base from '@templates/Base.astro'

export const prerender = false

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const result = Astro.getActionResult(actions.sendEmail)

// No-JS submissions: redirect after a successful POST so a reload can't resend it
if (result && !result.error) {
  return Astro.redirect(`${Astro.url.pathname}?sent=1`, 303)
}

const sent = Astro.url.searchParams.has('sent')
const errorCode = result?.error?.code
---
<Base pathToTranslate="contact" title={t('contact.meta.title')} description={t('contact.meta.description')}>
  <ContactPage sent={sent} errorCode={errorCode} />
</Base>
