---
import { type CollectionEntry } from 'astro:content'
import Note from '@components/Note.astro'
import { getPublishedNotes, PAGINATION_SIZE } from '@helpers/collections'
import Base from '@templates/Base.astro'
import type { GetStaticPaths, Page } from 'astro'

export const prerender = true
export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const publishedNotesEntries = await getPublishedNotes('es')

  return paginate(publishedNotesEntries, {
    pageSize: PAGINATION_SIZE,
  })
}
interface Props {
  page: Page<CollectionEntry<'notas'>>
}
const { page } = Astro.props
---
<Base
  title={`Archivo de notas · ${page.currentPage}`}
  pathToTranslate="internal-note"
  pathToTranslateNote={String(page.currentPage)}
>
<h1>Archivo de notas</h1>
<p>Página {page.currentPage} de {page.lastPage}</p>

<ul class="page-list">
  {page.data.map(note=>{
    return <li>
      <Note note={note} />
    </li>
  })}
</ul>
<footer class="bp-content-grid">
  <div class="prev-next">
    {page.currentPage > 1 && (
      <a href={page.url.prev} rel="prev">
        ← Página anterior
      </a>
    )}
    {page.currentPage < page.lastPage && (
      <a href={page.url.next} rel="next">
        Página siguiente →
      </a>
    )}
  </div>
</footer>
</Base>
<style>
  footer{
    padding-block: 1lh;
  }
  .prev-next{
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: var(--bp-text-sm);
  }
  a {
    color: var(--site-color-accent);
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
  }
  .page-list{
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    /* min() keeps a single column from overflowing on phones narrower than 300px + gutter */
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 1rem;
  }
  p{
    padding-block: 1lh;
  }
</style>