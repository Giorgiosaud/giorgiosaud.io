---
import { getLangFromUrl, useTranslatedPath } from '@i18n/utils'

const lang = getLangFromUrl(Astro.url)
const { translatePath } = useTranslatedPath(lang)

const legal = [
  {
    label: lang === 'es' ? 'Política de Privacidad' : 'Privacy Policy',
    path: translatePath('privacy', lang),
  },
  {
    label: lang === 'es' ? 'Términos de Servicio' : 'Terms of Service',
    path: translatePath('terms', lang),
  },
  {
    label: lang === 'es' ? 'Política de Cookies' : 'Cookie Policy',
    path: translatePath('cookies', lang),
  },
]
---

<footer class="full-width">
  <p>
    Copyleft © {new Date().getFullYear()} Giorgiosaud.io... None rights reserved.
  </p>
  <nav class="legal-links" aria-label="Legal">
    {legal.map(({ label, path }) => (
      <a href={path}>{label}</a>
    ))}
  </nav>
</footer>

<style>
  footer {
    margin-top: 1lh;
    text-align: center;
    background: var(--bp-color-bg-subtle);
    padding-block: 1lh;
    color: var(--bp-color-text-muted);
    border-top: 1px solid var(--bp-color-border);

    p {
      font-size: var(--bp-text-sm);
    }
  }

  .legal-links {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin-top: 0.5rem;

    a {
      font-size: var(--bp-text-xs);
      color: var(--bp-color-text-muted);
      text-decoration: none;

      &:hover {
        text-decoration: underline;
        color: var(--site-color-accent);
      }
    }
  }
</style>
