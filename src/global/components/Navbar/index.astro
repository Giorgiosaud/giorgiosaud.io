---
import { LoginButton, UserAvatar } from '@components/auth'
import {
  getLangFromUrl,
  type RouteNames,
  useTranslatedPath,
  useTranslations,
} from '@i18n/utils'

interface Props {
  pathToTranslate: RouteNames
  pathToTranslateNote?: string
}

const { pathToTranslate, pathToTranslateNote } = Astro.props
const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const { translatePath } = useTranslatedPath(lang)

const langToTranslate = lang === 'es' ? 'en' : 'es'
const langLabel = lang === 'es' ? 'EN' : 'ES'

const menuItems = [
  {
    title: t('nav.title'),
    path: translatePath('notebook', lang),
  },
  {
    title: t('nav.about-me'),
    path: translatePath('about-me', lang),
  },
  {
    title: t('nav.contact'),
    path: translatePath('contact', lang),
  },
]
---

<nav class="floating-nav" aria-label="Site header">
  <div class="pill">
    <a class="logo" href={translatePath('home', lang)}>
      Giorgiosaud<span class="logo-accent">.io</span>
    </a>

    <div class="sep" aria-hidden="true"></div>

    {menuItems.map(({ title, path }) => (
      <a
        href={path}
        class="nav-link"
        aria-current={path === Astro.url.pathname && path !== '/' ? 'page' : undefined}
      >
        {title}
      </a>
    ))}

    <div class="sep" aria-hidden="true"></div>

    <a
      href={translatePath(pathToTranslate, langToTranslate, pathToTranslateNote)}
      class="nav-link lang-link"
    >
      {langLabel}
    </a>

    <div class="auth-actions">
      <LoginButton client:idle lang={lang} />
      <UserAvatar client:idle lang={lang} />
    </div>
  </div>
</nav>

<style>
  /*
   * Floating pill nav (desktop). Site component on the DS token chain.
   * Public API (set on a scoped ancestor, never :root):
   *   --site-nav-background   pill background (default: --site-color-glass)
   *   --site-nav-border       pill border (default: 1px solid --bp-color-border)
   *   --site-nav-link-color   link text (default: --bp-color-text-muted)
   */
  .floating-nav {
    display: none;
    pointer-events: auto;

    @media (width >= 48rem) {
      display: flex;
      justify-content: center;
    }
  }

  .pill {
    --_background: var(--site-nav-background, var(--site-color-glass));
    --_border: var(--site-nav-border, 1px solid var(--bp-color-border));
    --_link-color: var(--site-nav-link-color, var(--bp-color-text-muted));

    display: flex;
    align-items: center;
    gap: var(--bp-space-2);
    background: var(--_background);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: var(--_border);
    border-radius: var(--bp-radius-full);
    padding: 0.4rem 0.8rem;
    box-shadow: var(--bp-shadow-lg);
    animation: compress-pill linear both;
    animation-timeline: scroll(root);
    animation-range: 0px 120px;
  }

  @keyframes compress-pill {
    to {
      gap: 0.1rem;
      padding: 0.3rem 0.4rem;
      backdrop-filter: blur(5px);
    }
  }

  @keyframes compress-link {
    to {
      padding: 0.4rem 0.4rem;
    }
  }

  .logo {
    font-family: var(--bp-font-mono);
    font-weight: var(--bp-font-weight-bold);
    font-size: 0.95rem;
    color: var(--bp-color-text);
    text-decoration: none;
    white-space: nowrap;
    padding: 0.3rem 1rem;
    animation: compress-link linear both;
    animation-timeline: scroll(root);
    animation-range: 0px 120px;

    .logo-accent {
      color: var(--site-color-accent);
    }
  }

  .sep {
    width: 1px;
    height: 18px;
    background: var(--bp-color-border);
    margin: 0 0.1rem;
    flex-shrink: 0;
  }

  .nav-link {
    color: var(--_link-color);
    font-size: var(--bp-text-sm);
    padding: 0.4rem 1rem;
    animation: compress-link linear both;
    animation-timeline: scroll(root);
    animation-range: 0px 120px;
    border-radius: var(--bp-radius-full);
    text-decoration: none;
    white-space: nowrap;
    transition:
      color var(--bp-duration-fast) var(--bp-ease),
      background-color var(--bp-duration-fast) var(--bp-ease);

    &:hover {
      color: var(--bp-color-text);
      background-color: var(--bp-color-bg-subtle);
    }

    &:focus-visible {
      outline: none;
      box-shadow: var(--bp-focus-ring);
    }

    &[aria-current='page'] {
      background: var(--bp-primary);
      color: var(--bp-primary-fg);
      font-weight: var(--bp-font-weight-medium);
    }
  }

  .lang-link {
    font-size: var(--bp-text-xs);
    font-weight: var(--bp-font-weight-semibold);
    letter-spacing: 0.04em;
  }

  .auth-actions {
    display: flex;
    align-items: center;
    gap: var(--bp-space-1);
  }
</style>

<script>
  function syncActive() {
    const path = window.location.pathname
    document.querySelectorAll<HTMLAnchorElement>('.floating-nav .nav-link:not(.lang-link)').forEach(a => {
      const matches = a.getAttribute('href') === path && path !== '/'
      if (matches) {
        a.setAttribute('aria-current', 'page')
      } else {
        a.removeAttribute('aria-current')
      }
    })
  }

  syncActive()
  document.addEventListener('astro:page-load', syncActive)
</script>
