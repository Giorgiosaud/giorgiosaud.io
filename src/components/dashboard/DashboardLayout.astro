---
import { getLangFromUrl, useTranslations } from '@i18n/utils'
import Base from '@templates/Base.astro'

interface Props {
  title: string
  currentPage: 'profile' | 'passkeys' | 'comments' | 'status' | 'share'
}

const { title, currentPage } = Astro.props
const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const basePath = lang === 'es' ? '/es/panel' : '/dashboard'

const navItems = [
  {
    id: 'profile',
    label: t('dashboard.nav.profile'),
    href: basePath,
  },
  {
    id: 'passkeys',
    label: t('dashboard.nav.passkeys'),
    href: `${basePath}/passkeys`,
  },
  {
    id: 'comments',
    label: t('dashboard.nav.comments'),
    href: `${basePath}/comments`,
  },
  {
    id: 'status',
    label: t('dashboard.nav.status'),
    href: `${basePath}/status`,
  },
  // Share is an admin-only tool (copy-ready social posts for each note).
  ...((
    Astro.locals.user as {
      role?: string
    } | null
  )?.role === 'admin'
    ? [
        {
          id: 'share',
          label: t('dashboard.nav.share'),
          href: `${basePath}/share`,
        },
      ]
    : []),
]
---

<Base title={`${t("dashboard.title")} - ${title}`} pathToTranslate="dashboard">
  <div class="dashboard-container">
    <header class="dashboard-header">
      <h1>{t("dashboard.title")}</h1>
    </header>

    <nav class="dashboard-nav" aria-label={t("dashboard.title")}>
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="nav-link"
            aria-current={currentPage === item.id ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="dashboard-content">
      <slot />
    </div>
  </div>
</Base>

<style>
  .dashboard-container {
    max-width: 900px;
    margin: var(--bp-space-8) auto;
    padding: 0 var(--bp-space-4);
  }

  .dashboard-header {
    margin-bottom: var(--bp-space-4);
  }

  .dashboard-header h1 {
    font-size: var(--bp-text-2xl);
    margin: 0;
  }

  /* Site nav (links + aria-current): bp-tabs expects role=tab + aria-selected */
  .dashboard-nav {
    display: flex;
    gap: var(--bp-space-1);
    margin-bottom: var(--bp-space-8);
    border-bottom: 1px solid var(--bp-color-border);
    flex-wrap: wrap;
  }

  .nav-link {
    padding: var(--bp-space-3) var(--bp-space-4);
    text-decoration: none;
    color: var(--bp-color-text-muted);
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    transition:
      color var(--bp-duration-fast) var(--bp-ease),
      border-color var(--bp-duration-fast) var(--bp-ease);
  }

  .nav-link:hover {
    color: var(--bp-color-text);
  }

  .nav-link:focus-visible {
    outline: none;
    box-shadow: var(--bp-focus-ring);
    border-radius: var(--bp-radius-sm);
  }

  .nav-link[aria-current="page"] {
    color: var(--site-color-accent);
    border-bottom-color: var(--site-color-accent);
    font-weight: var(--bp-font-weight-semibold);
  }

  .dashboard-content {
    min-height: 400px;
  }
</style>
