---
import Badges from '@components/Badges/index.astro'
import CollectionStack from '@components/CollectionStack.astro'
import Hero from '@components/Hero.astro'
import Logos from '@components/Logos.astro'
import NotesLatest from '@components/NotesLatest.astro'
import { useTranslatedPath, useTranslations } from '@i18n/utils'
import Base from '@templates/Base.astro'
import '@be-partner-labs/ds/components/button'

interface Props {
  lang: 'en' | 'es'
}

const { lang } = Astro.props
const t = useTranslations(lang)
const { translatePath } = useTranslatedPath(lang)
const collection = lang === 'en' ? 'notes' : 'notas'
const notebookHref = translatePath('notebook', lang)
---

<Base pathToTranslate="home">
  <Hero description={t("hero.description")} title={t("hero.title")} />
  <NotesLatest collection={collection} />
  <CollectionStack />
  <Badges title={t("badges.title")} readMore={t("badges.readMore")} />
  <section class="cta full-width">
    <blockquote>
      <p>{t("cta.description")}</p>
      <a href={notebookHref} class="bp-btn bp-btn--lg cta-btn">{t("cta.action")}</a>
    </blockquote>
  </section>
  <Logos />
  <style>
    .cta {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 28rem;
      background: var(--bp-primary-subtle);
      border-block: 1px solid var(--bp-color-border);
    }

    blockquote {
      max-width: 640px;
      padding: 0 2rem;
      margin: 0;
      position: relative;
      animation: cta-parallax linear both;
      animation-timeline: view();
      animation-range: entry 0% exit 100%;
    }

    @keyframes cta-parallax {
      from { transform: translateY(120px) scale(0.95); }
      to   { transform: translateY(-120px) scale(1.05); }
    }

    blockquote::before {
      content: '\201C';
      position: absolute;
      top: -2rem;
      left: 1rem;
      font-size: 8rem;
      line-height: 1;
      color: color-mix(in srgb, var(--site-color-accent) 25%, transparent);
      font-family: Georgia, serif;
      pointer-events: none;
    }

    blockquote p {
      font-size: clamp(1.5rem, 4vw, 2.5rem);
      font-style: italic;
      font-weight: var(--bp-font-weight-semibold);
      color: var(--bp-color-text);
      line-height: 1.3;
      margin: 0 0 2rem;
      text-wrap: balance;
    }

    .cta-btn {
      --btn-border-radius: var(--bp-radius-full);
    }
  </style>
</Base>
