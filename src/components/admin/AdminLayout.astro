---
import Base from '@templates/Base.astro'

interface Props {
  title: string
  currentPage: 'dashboard' | 'comments' | 'users' | 'notifications'
}

const { title, currentPage } = Astro.props

const navItems = [
  {
    id: 'dashboard',
    label: 'Dashboard',
    href: '/admin',
  },
  {
    id: 'notifications',
    label: 'Notifications',
    href: '/admin/notifications',
  },
  {
    id: 'comments',
    label: 'Comments',
    href: '/admin/comments',
  },
  {
    id: 'users',
    label: 'Users',
    href: '/admin/users',
  },
]
---

<Base title={`Admin - ${title}`} pathToTranslate="home">
  <div class="admin-container">
    <header class="admin-header">
      <h1>Admin Dashboard</h1>
    </header>

    <nav class="admin-nav" aria-label="Admin">
      {navItems.map(item => (
        <a
          href={item.href}
          class="nav-link"
          aria-current={currentPage === item.id ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="admin-content">
      <slot />
    </div>
  </div>
</Base>

<style>
  .admin-container {
    max-width: 900px;
    margin: var(--bp-space-8) auto;
    padding: 0 var(--bp-space-4);
  }

  .admin-header {
    margin-bottom: var(--bp-space-4);
  }

  .admin-header h1 {
    font-size: var(--bp-text-2xl);
    margin: 0;
  }

  /* Site nav (links + aria-current): bp-tabs expects role=tab + aria-selected */
  .admin-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--bp-space-1);
    margin-bottom: var(--bp-space-8);
    border-bottom: 1px solid var(--bp-color-border);
  }

  .nav-link {
    padding: var(--bp-space-3) var(--bp-space-4);
    text-decoration: none;
    color: var(--bp-color-text-muted);
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    transition:
      color var(--bp-duration-fast) var(--bp-ease),
      border-color var(--bp-duration-fast) var(--bp-ease);
  }

  .nav-link:hover {
    color: var(--bp-color-text);
  }

  .nav-link:focus-visible {
    outline: none;
    box-shadow: var(--bp-focus-ring);
    border-radius: var(--bp-radius-sm);
  }

  .nav-link[aria-current='page'] {
    color: var(--site-color-accent);
    border-bottom-color: var(--site-color-accent);
    font-weight: var(--bp-font-weight-semibold);
  }

  .admin-content {
    min-height: 400px;
  }
</style>
