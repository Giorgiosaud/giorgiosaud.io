---
import ContactForm from '@components/ContactForm.astro'
import { getLangFromUrl, useTranslations } from '@i18n/utils'

interface Props {
  sent?: boolean
  errorCode?: string
}

const { sent, errorCode } = Astro.props
const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const tx = (key: string) => t(key as Parameters<typeof t>[0]) as string
---
<section class="contact" aria-labelledby="contact-heading">
  <header class="contact-intro">
    <h1 id="contact-heading">{tx('contact.heading')}</h1>
    <p>{tx('contact.intro')}</p>
  </header>

  <ContactForm sent={sent} errorCode={errorCode} />

  <aside class="contact-aside" aria-label={tx('contact.aside.title')}>
    <p class="contact-aside__title">{tx('contact.aside.title')}</p>
    <ul>
      <li><a href="https://www.linkedin.com/in/giorgiosaud/" rel="me noopener" target="_blank">{tx('contact.aside.linkedin')}</a></li>
      <li><a href="mailto:jorgelsaud@gmail.com">{tx('contact.aside.email')}</a></li>
    </ul>
  </aside>
</section>

<style>
  .contact {
    display: grid;
    gap: var(--bp-space-8, 2rem);
    max-inline-size: 48rem;
    margin-inline: auto;
    padding-block: var(--bp-space-8, 2rem);
  }

  .contact-intro {
    display: grid;
    gap: var(--bp-space-3, 0.75rem);

    h1 {
      font-size: clamp(2rem, 5vw, 2.75rem);
      line-height: 1.1;
    }

    p {
      max-inline-size: 60ch;
      color: var(--bp-color-text-muted);
    }
  }

  .contact-aside {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--bp-space-3, 0.75rem) var(--bp-space-5, 1.25rem);
    padding-block-start: var(--bp-space-5, 1.25rem);
    border-block-start: 1px solid var(--bp-color-border);
    font-size: var(--bp-text-sm);

    ul {
      display: flex;
      gap: var(--bp-space-5, 1.25rem);
    }

    a {
      color: var(--bp-primary);
      text-underline-offset: 0.2em;
    }
  }

  .contact-aside__title {
    color: var(--bp-color-text-muted);
  }
</style>
