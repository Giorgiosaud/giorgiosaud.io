---
import '@be-partner-labs/ds/components/button'
interface Props {
  lang?: 'en' | 'es'
  noteId?: string
}

const { lang = 'en', noteId = '' } = Astro.props

const i18n = {
  en: {
    buttonTitle: 'Generate summary',
    loading: 'Generating Summary...',
    unavailable: 'The summarization API is not available in this browser.',
    inputLang: 'en',
    outputLang: 'en',
    streamLang: 'en',
  },
  es: {
    buttonTitle: 'Generar resumen',
    loading: 'Generando resumen...',
    unavailable: 'La API de resumen no está disponible en este navegador.',
    inputLang: 'es',
    outputLang: 'es',
    streamLang: 'es',
  },
}

const t = i18n[lang]
---

<!-- Floating bubble button for summary generation (hidden until API is available) -->
<button
  id="generate-summary-bubble"
  class="summary-bubble"
  aria-label={t.buttonTitle}
  title={t.buttonTitle}
  data-note-id={noteId}
  data-lang={lang}
  hidden
>
  <span aria-hidden="true">🤖</span>
</button>

<!-- Emergent bubble/modal for summary result -->
<dialog
  id="summary-modal"
  class="summary-modal"
  aria-label={t.buttonTitle}
  data-loading={t.loading}
  data-unavailable={t.unavailable}
>
  <button id="close-summary-modal" class="bp-btn bp-btn--secondary bp-btn--icon bp-btn--sm close-summary-modal" type="button" aria-label="Close">&times;</button>
  <div id="summary-content" aria-live="polite" aria-atomic="false"></div>
</dialog>

<script>
  import { trackEvent } from "@helpers/datalayer";

  // Detect which summarizer API is available: Chrome's global Summarizer or Safari's window.ai.summarizer
  // biome-ignore lint/suspicious/noExplicitAny: experimental browser APIs without types
  const g = self as any;
  const SummarizerAPI = "Summarizer" in g ? g.Summarizer : (g.ai?.summarizer ?? null);

  const summaryBubble = document.getElementById("generate-summary-bubble") as HTMLButtonElement | null;
  const summaryModal = document.getElementById("summary-modal") as HTMLDialogElement | null;
  const summaryContent = document.getElementById("summary-content");
  const closeModalBtn = document.getElementById("close-summary-modal") as HTMLButtonElement | null;

  if (SummarizerAPI && summaryBubble && summaryModal && summaryContent && closeModalBtn) {
    const loadingText = summaryModal.dataset.loading ?? "";
    const unavailableText = summaryModal.dataset.unavailable ?? "";

    const showMessage = (text: string) => {
      const p = document.createElement("p");
      p.textContent = text;
      summaryContent.replaceChildren(p);
    };

    summaryBubble.hidden = false;

    // Lazy-load the markdown parser + sanitizer only when the user asks for a summary.
    // Both are pinned npm deps (bundled by Vite), not a floating CDN import.
    let renderMarkdown: ((md: string) => string) | null = null;
    async function getRenderer() {
      if (!renderMarkdown) {
        const [{ marked }, { default: DOMPurify }] = await Promise.all([
          import("marked"),
          import("dompurify"),
        ]);
        renderMarkdown = (md) => DOMPurify.sanitize(marked.parse(md, { async: false }));
      }
      return renderMarkdown;
    }

    async function summarizeContent() {
      showMessage(loadingText);
      summaryModal?.showModal();

      try {
        const options = {
          sharedContext:
            "This is a FrontEnd developer article. Use the same language as the text. Author is Giorgiosaud. Tone: informal but technical.",
          type: "key-points",
          format: "markdown",
          length: "medium",
        };

        const availability = await SummarizerAPI.availability(options);
        // Both APIs return 'unavailable' when not supported
        if (availability === "unavailable" || availability === "no") {
          showMessage(unavailableText);
          return;
        }

        const render = await getRenderer();

        const summarizer = await SummarizerAPI.create(options);
        const text = document.getElementById("content")?.innerText ?? "";

        // Both APIs support summarizeStreaming
        const stream = summarizer.summarizeStreaming(text);
        let result = "";
        let prevLength = 0;
        for await (const chunk of stream) {
          // Safari yields full accumulated text; Chrome yields only the new delta.
          // Detect by checking if chunk starts where we left off.
          if (chunk.length > prevLength && chunk.startsWith(result)) {
            result = chunk; // Safari: full text
          } else {
            result += chunk; // Chrome: delta
          }
          prevLength = result.length;
          if (summaryContent) summaryContent.innerHTML = render(result);
        }
      } catch (err) {
        showMessage(unavailableText);
        console.error("Summarizer error:", err);
      }
    }

    summaryBubble.addEventListener("click", () => {
      trackEvent({
        event: "ai_summarizer_open",
        note_id: summaryBubble.dataset.noteId ?? "",
        lang: (summaryBubble.dataset.lang ?? "en") as "en" | "es",
      });
      summarizeContent();
      // Move focus into dialog for keyboard/screen reader users
      setTimeout(() => closeModalBtn.focus(), 50);
    });

    closeModalBtn.addEventListener("click", () => {
      summaryModal.close();
      summaryContent.replaceChildren();
      summaryBubble.focus();
    });

    summaryModal.addEventListener("click", (e) => {
      if (e.target === summaryModal) {
        summaryModal.close();
        summaryContent.replaceChildren();
      }
    });
  }
</script>

<style>
  .summary-bubble[hidden] { display: none; }
  .summary-bubble {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    @media (width < 48rem) {
      bottom: calc(4.5rem + 1rem);
    }
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--bp-primary);
    color: var(--bp-primary-fg);
    box-shadow: var(--bp-shadow-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    cursor: pointer;
    z-index: 2000;
    border: 2px solid var(--bp-color-bg-elevated);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .summary-bubble:focus-visible {
    outline: none;
    box-shadow: var(--bp-focus-ring);
  }

  .summary-bubble:hover {
    transform: scale(1.08);
    box-shadow: var(--bp-shadow-xl);
  }

  .summary-modal {
    /* Reset browser dialog centering defaults */
    position: fixed;
    margin: 0;
    inset: auto;
    bottom: 6rem;
    right: 2rem;
    @media (width < 48rem) {
      bottom: calc(4.5rem + 1rem + 4rem);
      right: 1rem;
      left: 1rem;
      width: auto;
    }
    width: 320px;
    max-width: calc(100vw - 2rem);
    max-height: 70vh;
    overflow-y: auto;
    background: var(--bp-color-bg-elevated);
    color: var(--bp-color-text);
    border-radius: var(--bp-radius-xl);
    box-shadow: var(--bp-shadow-xl);
    padding: 2rem 1.5rem 1.5rem 1.5rem;
    border: 1px solid var(--bp-color-border);
    z-index: 2100;
    flex-direction: column;
    gap: 1rem;
    animation: bubbleIn 0.3s ease;
    &[open] { display: flex; }
  }
  .summary-modal::backdrop { background: rgba(0,0,0,0.3); }
  code {
    background: var(--bp-color-bg-subtle);
    color: var(--bp-color-text);
    font-family: var(--bp-font-mono);
    padding: 0.2rem 0.4rem;
    border-radius: var(--bp-radius-sm);
  }

  .close-summary-modal {
    position: absolute;
    top: var(--bp-space-3);
    right: var(--bp-space-3);
    font-size: var(--bp-text-lg);
  }

  #summary-content {
    font-size: var(--bp-text-base);
    color: var(--bp-color-text);
    & p, & li { line-height: 1.6; }
  }

  @keyframes bubbleIn {
    from {
      opacity: 0;
      transform: translateY(20px) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
</style>
